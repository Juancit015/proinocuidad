# Proinocuidad — sitio estático en production (LiteSpeed/Apache)

# Charset por defecto para HTML y CSS
AddDefaultCharset UTF-8

# La página de error 404 debe servirse con estado 404:
# el hosting no lo hace por convención sin esta directiva.
ErrorDocument 404 /404.html

# Página índice de cada carpeta
DirectoryIndex index.html

# TODO el HTML, JS y CSS, y la base de certificados, NO se cachean a largo
# plazo: LiteSpeed los sirve con max-age=604800 por defecto, y una copia
# vieja en el navegador revive bugs ya corregidos y esconde mejoras nuevas
# tras cada deploy (p. ej. el formulario que saltaba a la página "Thanks"
# pese al fix del 2026-10-25, o la página de verificación que recargaba al
# escanear el QR del 2026-11-10). Son ficheros pequeños: el coste de
# revalidar es mínimo frente al riesgo.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "certificados\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
