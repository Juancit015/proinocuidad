# Proinocuidad — sitio estático en production (LiteSpeed/Apache)

# Charset por defecto para HTML y CSS
AddDefaultCharset UTF-8

# La página de error 404 debe servirse con estado 404:
# el hosting no lo hace por convención sin esta directiva.
ErrorDocument 404 /404.html

# Página índice de cada carpeta
DirectoryIndex index.html

# HTML, JS y CSS clave NO se cachean a largo plazo: LiteSpeed los sirve
# con max-age=604800 por defecto, y un HTML/JS viejo cacheado en el
# navegador del usuario revive bugs ya corregidos y esconde mejoras nuevas
# tras cada deploy (p. ej. el formulario que saltaba a la página "Thanks"
# pese al fix del 2026-10-25). Son ficheros pequeños: el coste de
# revalidar es mínimo frente al riesgo.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  <Files "main.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  <Files "main.css">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
